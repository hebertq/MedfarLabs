@inherits LayoutComponentBase

<div id="top" tabindex="-1" style="position:absolute; top:0; left:0; width:0; height:0; outline:none;"></div>
<div class="page">
    <main>
        <MedFarLab.Components.Sections.MedFarLabHeader />
        
        <article class="content">
            @Body
        </article>
        
        <MedFarLab.Components.Sections.MedFarLabFooter />
    </main>
</div>


<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
