@rendermode InteractiveServer
@implements IDisposable
@using System.Threading

<section class="section" style="background-color: var(--color-bg-light); overflow: hidden; padding-top: 4rem; padding-bottom: 7rem;">
    <div class="container">
        <div class="text-center reveal mb-xl">
            <h2 class="section-title">La Línea de Vida Clínica</h2>
            <p style="color: var(--color-text-muted); max-width: 650px; margin: 0 auto;">
                Observa cómo viaja la información de tu paciente en tiempo real y sin salir del portal corporativo.
            </p>
        </div>

        <div class="wizard-container">
            
            <!-- Wizard Navigation Tabs -->
            <div class="wizard-tabs">
                <button class="wizard-tab @(activeStep == 1 ? "active" : "")" @onclick="() => SetStep(1)">
                    <div class="tab-indicator">
                        <div class="tab-progress @(activeStep == 1 ? "filling" : "")"></div>
                    </div>
                    <span class="tab-label">1. El Médico Diagnostica</span>
                </button>
                
                <button class="wizard-tab @(activeStep == 2 ? "active" : "")" @onclick="() => SetStep(2)">
                    <div class="tab-indicator">
                        <div class="tab-progress @(activeStep == 2 ? "filling" : "")"></div>
                    </div>
                    <span class="tab-label">2. El Laboratorio Confirma</span>
                </button>
                
                <button class="wizard-tab @(activeStep == 3 ? "active" : "")" @onclick="() => SetStep(3)">
                    <div class="tab-indicator">
                        <div class="tab-progress @(activeStep == 3 ? "filling" : "")"></div>
                    </div>
                    <span class="tab-label">3. La Farmacia Despacha</span>
                </button>
            </div>

            <!-- Dynamic Content Window -->
            <div class="wizard-content-window glass-card">
                
                @if (activeStep == 1)
                {
                    <div class="step-pane fade-in">
                        <div class="step-icon text-primary bg-primary-light">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" class="vector-icon" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                        </div>
                        <div class="step-text">
                            <h4>El Médico Diagnostica</h4>
                            <p>Durante la consulta, el médico dicta o escribe en el Expediente Clínico Modular estructurado. Al finalizar, emite una orden de laboratorios que viaja a la Nube mediante encriptación AES-256 en fracción de segundos, eliminando la receta en papel.</p>
                        </div>
                    </div>
                }
                else if (activeStep == 2)
                {
                    <div class="step-pane fade-in">
                        <div class="step-icon text-accent bg-accent-light" style="background-color: rgba(37, 99, 235, 0.1);">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" class="vector-icon" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.31"/><path d="M14 9.3V1.99"/><path d="M8.5 2h7"/><path d="M14 9.3a6.5 6.5 0 1 1-4 0"/><circle cx="12" cy="16" r="2.5"/></svg>
                        </div>
                        <div class="step-text">
                            <h4>El Laboratorio Confirma</h4>
                            <p>La química sanguínea y reportes se cargan directamente al perfil enlazado. El laboratorio no requiere papelería ni llamadas telefónicas; los rangos anómalos resaltan inmediatamente en la pantalla del doctor primario de forma remota.</p>
                        </div>
                    </div>
                }
                else if (activeStep == 3)
                {
                    <div class="step-pane fade-in">
                        <div class="step-icon text-secondary" style="background-color: rgba(16, 185, 129, 0.1);">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" class="vector-icon" stroke="var(--color-secondary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </div>
                        <div class="step-text">
                            <h4>La Farmacia Despacha</h4>
                            <p>Con el diagnóstico preciso, se genera una receta electrónica firmada y única (QR). La farmacia aliada escanea la receta garantizando cero índices de falsificación o medicación equivocada, cerrando así todo el círculo de atención.</p>
                        </div>
                    </div>
                }

            </div>

        </div>
    </div>
</section>

@code {
    private int activeStep = 1;
    private CancellationTokenSource cts = new();
    private bool userInteracted = false;

    protected override void OnInitialized()
    {
        // Fire and forget the autoplay timer
        _ = AutoPlayCarousel(cts.Token);
    }

    private void SetStep(int step)
    {
        userInteracted = true; // Stop autoplay if user manually clicks
        cts.Cancel(); 
        
        activeStep = step;
        StateHasChanged();
    }

    private async Task AutoPlayCarousel(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && !userInteracted)
            {
                // Un tempo justo para leer los parrafos
                await Task.Delay(8500, token);
                
                if (token.IsCancellationRequested || userInteracted) break;

                activeStep = activeStep == 3 ? 1 : activeStep + 1;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
            // Expected when user clicks
        }
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}

<style>
    .wizard-container {
        max-width: 900px;
        margin: 0 auto;
        background: transparent;
    }

    /* Wizard Tabs Container */
    .wizard-tabs {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 2rem;
    }
    
    @@media (min-width: 768px) {
        .wizard-tabs {
            flex-direction: row;
            justify-content: space-between;
            gap: 1.5rem;
        }
    }

    .wizard-tab {
        flex: 1;
        background: transparent;
        border: none;
        padding: 0.5rem 0;
        cursor: pointer;
        text-align: left;
        outline: none;
        opacity: 0.5;
        transition: opacity var(--transition-speed);
    }
    
    .wizard-tab.active {
        opacity: 1;
    }
    
    .wizard-tab:hover {
        opacity: 0.8;
    }

    .tab-indicator {
        width: 100%;
        height: 4px;
        background: rgba(0,0,0,0.1);
        border-radius: 4px;
        margin-bottom: 0.8rem;
        overflow: hidden;
        position: relative;
    }

    .tab-progress {
        position: absolute;
        top: 0; left: 0; bottom: 0;
        width: 0%;
        background: var(--color-primary);
        border-radius: 4px;
    }

    /* La barra se llena en los 8.5s del Task.Delay */
    .wizard-tab.active .tab-progress.filling {
        animation: fillBar 8.5s linear forwards;
    }
    
    @@keyframes fillBar {
        0% { width: 0%; }
        100% { width: 100%; }
    }

    /* Si se interactuó y paró, la barra no se anima pero indica actividad */
    .wizard-tab.active .tab-progress {
        width: 100%; 
    }

    .tab-label {
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: 1.05rem;
        color: var(--color-primary-dark);
    }

    /* Window Display */
    .wizard-content-window {
        padding: 3rem;
        background: white;
        border-radius: 20px;
        min-height: 250px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
    }

    .step-pane {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 2rem;
        width: 100%;
    }
    
    @@media (min-width: 600px) {
        .step-pane {
            flex-direction: row;
            align-items: center;
        }
    }

    .step-icon {
        width: 80px; height: 80px;
        border-radius: 50%;
        display: flex; justify-content: center; align-items: center;
        flex-shrink: 0;
    }
    
    .bg-primary-light { background-color: rgba(30, 58, 138, 0.08); }

    .step-text h4 {
        font-size: 1.6rem;
        color: var(--color-primary);
        margin-bottom: 0.8rem;
    }
    
    .step-text p {
        color: var(--color-text-muted);
        font-size: 1.1rem;
        line-height: 1.7;
        margin: 0;
    }

    /* Micro-interacción: Fade In */
    .fade-in {
        animation: fadeInUp 0.4s ease-out forwards;
    }
</style>
