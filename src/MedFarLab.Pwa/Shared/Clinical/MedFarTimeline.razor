@using MudBlazor
@using MedFarLab.Application.Features.Patient.Models

<div class="mf-timeline">
    @if (!Consultations?.Any() == true)
    {
        <MedFarLab.Pwa.Shared.Components.MedFarEmptyState Title="Sin consultas previas"
                          Icon="@Icons.Material.Outlined.EventNote"
                          Message="Este paciente no tiene consultas registradas aún."/>
    }
    else
    {
        @foreach (var c in Consultations!)
        {
            <div class="mf-timeline-item @(c.IsOwner ? "mf-timeline-owner" : "mf-timeline-shared")">
                <!-- Línea y punto de tiempo -->
                <div class="mf-timeline-indicator">
                    <div class="mf-timeline-dot @(c.IsOwner ? "dot-owner" : "dot-shared")"/>
                    <div class="mf-timeline-line"/>
                </div>

                <!-- Tarjeta de la consulta -->
                <MudCard Class="mf-timeline-card surface-glass mb-3" Elevation="0">
                    <MudCardContent Class="pa-5">
                        <div class="d-flex align-center justify-space-between mb-3">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">
                                    @c.Date.ToString("dd MMM yyyy — hh:mm tt", new System.Globalization.CultureInfo("es-MX"))
                                </MudText>
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                                    @c.DoctorName
                                </MudText>
                            </div>
                            <div class="d-flex align-center gap-2">
                                @if (!c.IsOwner)
                                {
                                    <MudTooltip Text="Solo puedes ver la patología principal">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Lock">
                                            Protegido
                                        </MudChip>
                                    </MudTooltip>
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Medium" OnClick="@(() => OnVerDetalle.InvokeAsync(c.ConsultationId))"/>
                            </div>
                        </div>

                        @* Patología Diagnosticada *@
                        @if (!string.IsNullOrEmpty(c.Pathology) || !string.IsNullOrEmpty(c.DiagnosisDescription))
                        {
                            <div class="mb-4">
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="d-block mb-1">Patología Diagnosticada:</MudText>
                                <div class="d-flex align-center gap-2">
                                    @if (!string.IsNullOrEmpty(c.Pathology))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ma-0">
                                            @c.Pathology
                                        </MudChip>
                                    }
                                    @if (!string.IsNullOrEmpty(c.DiagnosisDescription))
                                    {
                                        <MudText Typo="Typo.body1" Class="font-weight-bold">@c.DiagnosisDescription</MudText>
                                    }
                                </div>
                            </div>
                        }

                        @* Análisis / Diagnóstico - solo si IsOwner *@
                        @if (c.IsOwner && (!string.IsNullOrEmpty(c.AnalysisData) || !string.IsNullOrEmpty(c.Summary)))
                        {
                            <MudPaper Elevation="0" Class="pa-4 mt-2" Style="background-color: var(--mud-palette-background-grey); border-radius: 8px; border-left: 4px solid var(--mud-palette-primary);">
                                @if (!string.IsNullOrEmpty(c.AnalysisData))
                                {
                                    <div class="mb-3">
                                        <MudText Typo="Typo.body2" Class="font-weight-bold text-primary mb-1">Análisis Clínico y Diagnóstico:</MudText>
                                        <MudText Typo="Typo.body1">@c.AnalysisData</MudText>
                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(c.Summary))
                                {
                                    <div class="mb-3">
                                        <MudText Typo="Typo.body2" Class="font-weight-bold text-primary mb-1">Análisis Clínico:</MudText>
                                        <MudText Typo="Typo.body1">@c.Summary</MudText>
                                    </div>
                                }
                            </MudPaper>
                        }
                        else if (!c.IsOwner)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="font-italic mt-2">
                                Análisis clínico protegido por otra organización.
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </div>
        }
    }
</div>

@code {
    [Parameter] public List<ClinicalHistoryItemVM>? Consultations { get; set; }
    [Parameter] public EventCallback<long> OnVerDetalle { get; set; }
}
