@using MudBlazor
@inject MedFarLab.Pwa.Services.MedFarMenuService MenuService
@inject MedFarLab.Pwa.Services.IUserContextService UserCtx
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject MedFarLab.Pwa.Services.MedFarThemeService ThemeService
<MudMenu AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight"
         Class="mf-profile-menu"
         Dense="true"
         PopoverClass="mf-profile-popover">

    <ActivatorContent>
        <MudIconButton Icon="@Icons.Material.Filled.Settings" 
                       Color="Color.Default" 
                       Edge="Edge.End" />
    </ActivatorContent>

    <ChildContent>
        <!-- Cabecera del dropdown -->
        <div class="mf-profile-header">
            <MudAvatar Color="Color.Primary" Size="Size.Large">
                @UserCtx.FullName?.FirstOrDefault()
            </MudAvatar>
            <div class="ml-3">
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                    @UserCtx.FullName
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @UserCtx.OrganizationName
                </MudText>
                <MudChip T="string" Size="Size.Small"
                         Color="Color.Primary" Variant="Variant.Outlined"
                         Class="mt-1">
                    @UserCtx.PrimaryRole
                </MudChip>
            </div>
        </div>

        <MudDivider Class="my-2"/>

        <!-- Sección de ajustes — agrupada dinámicamente -->
        @if (MenuService.SettingsGroups != null && MenuService.SettingsGroups.Any())
        {
            @foreach (var grupo in MenuService.SettingsGroups)
            {
                <!-- Etiqueta del grupo -->
                <div class="mf-settings-group-label">
                    <MudText Typo="Typo.overline">
                        @MenuService.GetGroupLabel(grupo.Key)
                    </MudText>
                </div>

                @foreach (var item in grupo)
                {
                    @if (item.IsDivider && item != grupo.First())
                    {
                        <MudDivider Class="my-1"/>
                    }

                    <MudMenuItem Icon="@GetMudIcon(item.Icon)"
                                 OnClick="@(() => Navegar(item.Route))"
                                 Class="mf-settings-item">
                        @item.Title
                    </MudMenuItem>
                }

                @if (grupo.Key < MenuService.SettingsGroups.Last().Key)
                {
                    <MudDivider Class="my-2"/>
                }
            }
        }
        else
        {
            <MudText Typo="Typo.caption" Class="px-4 py-2" Color="Color.Secondary">
                No hay ajustes configurados.
            </MudText>
        }

        <MudDivider Class="my-2"/>

        <!-- Modo Oscuro -->
        <MudMenuItem Icon="@(ThemeService.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                     OnClick="@(() => ThemeService.Toggle())"
                     Class="mf-settings-item">
            @(ThemeService.IsDarkMode ? "Modo Claro" : "Modo Oscuro")
        </MudMenuItem>

        <MudDivider Class="my-2"/>

        <!-- Cerrar sesión — siempre al fondo -->
        <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                     OnClick="@CerrarSesion"
                     Class="mf-logout-item">
            Cerrar sesión
        </MudMenuItem>

    </ChildContent>
</MudMenu>

@code {
    private void Navegar(string route) => Nav.NavigateTo(route);

    private string GetMudIcon(string? iconName)
    {
        if (string.IsNullOrEmpty(iconName)) return Icons.Material.Filled.Circle;
        
        var shortName = iconName.Replace("Icons.Material.Filled.", "");
        
        return shortName switch
        {
            "Person" => Icons.Material.Filled.Person,
            "Lock" => Icons.Material.Filled.Lock,
            "Settings" => Icons.Material.Filled.Settings,
            "Notifications" => Icons.Material.Filled.Notifications,
            "NoteAlt" => Icons.Material.Filled.NoteAlt,
            "Receipt" => Icons.Material.Filled.Receipt,
            "Business" => Icons.Material.Filled.Business,
            "Group" => Icons.Material.Filled.Group,
            "Science" => Icons.Material.Filled.Science,
            "Biotech" => Icons.Material.Filled.Biotech,
            "LocalPharmacy" => Icons.Material.Filled.LocalPharmacy,
            "Dashboard" => Icons.Material.Filled.Dashboard,
            "Key" => Icons.Material.Filled.Key,
            "Assignment" => Icons.Material.Filled.Assignment,
            "Print" => Icons.Material.Filled.Print,
            "Storefront" => Icons.Material.Filled.Storefront,
            "Schedule" => Icons.Material.Filled.Schedule,
            "MonitorHeart" => Icons.Material.Filled.MonitorHeart,
            _ => Icons.Material.Filled.SettingsApplications
        };
    }

    private async Task CerrarSesion()
    {
        var confirm = await DialogService.ShowMessageBox(
            "Cerrar sesión",
            "¿Estás seguro de que deseas cerrar tu sesión?",
            yesText: "Cerrar sesión",
            cancelText: "Cancelar");

        if (confirm == true)
            Nav.NavigateTo("/logout", forceLoad: true);
    }
}
