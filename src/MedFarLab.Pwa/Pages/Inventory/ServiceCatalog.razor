@page "/inventory/catalog"
@using MedFarLab.Pwa.Shared.Components

<PageTitle>Catálogo de Servicios - MedFarLab</PageTitle>

<MedFarPageHeader Title="Gestión de Catálogo y Precios"
                  Icon="@Icons.Material.Filled.List"
                  Subtitle="Directorio unificado de Servicios Médicos, Laboratorio y Procedimientos."
                  ShowBack="true"
                  OnBackClick="GoBack">
    <PrimaryActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNewServiceModal" Class="btn-emerald-gradient">
            Nuevo Servicio
        </MudButton>
    </PrimaryActions>
    <SecondaryActions>
        <MudMenuItem Icon="@Icons.Material.Filled.FileDownload">
            Exportar
        </MudMenuItem>
    </SecondaryActions>
</MedFarPageHeader>

<div class="mt-4">
    <MedFarTable TItem="MedFarLab.Application.Features.Inventory.Models.ServiceItemVM" 
                 Items="@Services" 
                 IsLoading="@IsLoading"
                 ShowSearch="true"
                 SearchPlaceholder="Buscar por Nombre, Código o Categoría..."
                 SearchFilter="@FilterFunc"
                 ColumnCount="7"
                 EmptyTitle="Catálogo Vacío"
                 EmptyMessage="No se han registrado servicios o productos en el inventario.">
        <HeaderContent>
            <MudTh>Código</MudTh>
            <MudTh>Nombre del Servicio</MudTh>
            <MudTh>Área/Categoría</MudTh>
            <MudTh>Precio Unitario</MudTh>
            <MudTh>Aplica Impuesto</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate Context="context">
            <MudTd DataLabel="Código">@context.Code</MudTd>
            <MudTd DataLabel="Nombre del Servicio">@context.Name</MudTd>
            <MudTd DataLabel="Área/Categoría">
                <MudChip T="string" Size="Size.Small" Color="@(context.Category == "Médico" ? Color.Info : context.Category == "Laboratorio" ? Color.Warning : Color.Success)" Variant="Variant.Outlined">
                    @context.Category
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Precio Unitario">
                <MudText Typo="Typo.body2" Class="fw-bold">$@context.UnitPrice.ToString("0.00")</MudText>
            </MudTd>
            <MudTd DataLabel="Aplica Impuesto">
                @if (context.IsTaxable)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" />
                }
            </MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Activo</MudChip>
            </MudTd>
            <MudTd DataLabel="Acciones">
                @if (context.Category == "Laboratorio" || context.Category == "Exámenes")
                {
                    <MudTooltip Text="Configurar Requerimientos de Muestra">
                        <MudIconButton Icon="@Icons.Material.Filled.Science" Color="Color.Warning" Size="Size.Small" OnClick="@(() => OpenSampleConfig(context))" />
                    </MudTooltip>
                }
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" />
            </MudTd>
        </RowTemplate>
    </MedFarTable>
</div>
