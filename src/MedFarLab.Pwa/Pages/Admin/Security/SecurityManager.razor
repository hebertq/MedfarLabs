@page "/admin/security"

<PageTitle>Seguridad Interna & Roles</PageTitle>

<PageActionHeader ShowBackButton="true" BackUrl="/admin/dashboard">
    <StatusContent>
        <div>
            <MudText Typo="Typo.h5" Class="text-secondary fw-bold">Políticas y Seguridad Corporativa</MudText>
            <MudText Typo="Typo.body2" Class="text-muted">Control transaccional RBAC: Grupos de Roles, Roles individuales y Permisos (Actions).</MudText>
        </div>
    </StatusContent>
</PageActionHeader>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-0">
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="Color.Secondary">
        
        <!-- Tab: Grupos de Roles -->
        <MudTabPanel Text="Grupos de Roles">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h6" Class="fw-bold">Grupos (RoleGroups)</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="OpenAddGroupModal">Crear Grupo</MudButton>
            </div>
            <MudDataGrid Items="@mockGroups" Dense="true" Bordered="true">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="ID" />
                    <PropertyColumn Property="x => x.Name" Title="Nombre Formateado" />
                    <PropertyColumn Property="x => x.Alias" Title="Alias Sistema" />
                    <TemplateColumn Title="Controles">
                        <CellTemplate>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info" OnClick="@(() => OpenEditGroupModal(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteGroup(context.Item))" />
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">Asignar Roles</MudButton>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        </MudTabPanel>

        <!-- Tab: Roles -->
        <MudTabPanel Text="Roles Básicos">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudText Typo="Typo.h6" Class="fw-bold">Lista de Roles</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="OpenAddRoleModal">Crear Rol</MudButton>
            </div>
            <MudDataGrid Items="@mockRoles" Dense="true" Bordered="true">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="ID" />
                    <PropertyColumn Property="x => x.Name" Title="Referencia (Name)" />
                    <TemplateColumn Title="Vincular">
                        <CellTemplate>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info" OnClick="@(() => OpenEditRoleModal(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteRole(context.Item))" />
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => OpenAssignActionsModal(context.Item))">Validar Permisos</MudButton>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        </MudTabPanel>

        <!-- Tab: Permisos -->
        <MudTabPanel Text="Action Permissions">
            <div class="d-flex justify-space-between align-center mb-4">
                <MudAlert Severity="Severity.Warning" Class="mr-4">Las acciones son insertadas al código fuente como Constantes. Desde aquí puedes visualizarlas y habilitar su lectura dinámica para los JWT de autenticación.</MudAlert>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="OpenAddActionModal">Nueva Acción</MudButton>
            </div>
            <MudDataGrid Items="@mockActions" Dense="true" Bordered="true">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="ID" />
                    <PropertyColumn Property="x => GetModuleName(x.ModuleId)" Title="Módulo C#" />
                    <PropertyColumn Property="x => x.Name" Title="Constante / Código" />
                    <PropertyColumn Property="x => x.Description" Title="Descripción" />
                    <TemplateColumn Title="Controles">
                        <CellTemplate>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info" OnClick="@(() => OpenEditActionModal(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAction(context.Item))" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        </MudTabPanel>

    </MudTabs>
</MudContainer>
