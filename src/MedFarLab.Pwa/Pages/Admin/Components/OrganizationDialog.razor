@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudTextField T="string" @bind-Value="Title" Label="Nombre Legal de la Organización" Required="true" RequiredError="Nombre es requerido"/>
            <MudTextField T="string" @bind-Value="Domain" Label="Dominio web (Ej: clinicaregional.com)" Required="true"/>
            <MudSwitch T="bool" @bind-Value="IsActive" Color="Color.Success">Estatus Activo</MudSwitch>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!success)">Guardar</MudButton>
    </DialogActions>
</MudDialog>

