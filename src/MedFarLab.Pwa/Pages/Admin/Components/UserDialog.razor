@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudTextField T="string" @bind-Value="Email" Label="Correo Electrónico" Required="true" RequiredError="Correo requerido" InputType="InputType.Email"/>
            <MudTextField T="string" @bind-Value="Name" Label="Nombre de la Persona" Required="true" RequiredError="Nombre requerido"/>
            <MudTextField T="string" @bind-Value="PhoneNumber" Label="Teléfono de Contacto" />
            <MudNumericField T="long" @bind-Value="OrgId" Label="ID Organización Asociada" Required="true"/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Info" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!success)">Procesar</MudButton>
    </DialogActions>
</MudDialog>

