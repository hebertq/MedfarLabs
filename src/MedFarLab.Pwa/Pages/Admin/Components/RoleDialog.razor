@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudTextField T="string" @bind-Value="Name" Label="Nombre de Referencia (Name)" Required="true" RequiredError="Nombre requerido"/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!success)">Procesar</MudButton>
    </DialogActions>
</MudDialog>

