@page "/admin/organizations/deprecated-legacy"
@using MedFarLab.Pwa.Shared.Components

<PageTitle>Organizaciones Clínicas B2B</PageTitle>

<MedFarPageHeader Title="Organizaciones"
                  Icon="@Icons.Material.Filled.Business"
                  Subtitle="Catálogo global de clientes SaaS."
                  ShowBack="true"
                  OnBackClick='() => NavManager.NavigateTo("/admin/dashboard")'>
    <PrimaryActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddModal" Class="btn-emerald-gradient">Nueva</MudButton>
    </PrimaryActions>
</MedFarPageHeader>

<div class="mt-4">
    <MedFarTable TItem="MedFarLab.Pwa.Pages.Admin.Identity.OrganizationsList.MockOrg"
                 Items="@mockOrgs"
                 IsLoading="@IsLoading"
                 ShowSearch="true"
                 SearchPlaceholder="Buscar por nombre o dominio..."
                 SearchFilter="@FilterFunc"
                 ColumnCount="5"
                 EmptyTitle="Sin Organizaciones"
                 EmptyMessage="No hay organizaciones registradas en el sistema.">
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Nombre Legal (Title)</MudTh>
            <MudTh>Dominio</MudTh>
            <MudTh>Estatus</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">@context.Id</MudTd>
            <MudTd DataLabel="Nombre Legal (Title)">@context.Title</MudTd>
            <MudTd DataLabel="Dominio">@context.Domain</MudTd>
            <MudTd DataLabel="Estatus">
                <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Error)" Size="Size.Small">
                    @(context.IsActive ? "Activa" : "Suspendida")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Acciones">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info" OnClick="@(() => OpenEditModal(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteOrganization(context))" />
            </MudTd>
        </RowTemplate>
    </MedFarTable>
</div>
