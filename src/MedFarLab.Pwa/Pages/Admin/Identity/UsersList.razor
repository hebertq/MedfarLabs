@page "/admin/users"
@using MedFarLab.Pwa.Shared.Components

<PageTitle>Usuarios Globales</PageTitle>

<MedFarPageHeader Title="Usuarios Globales"
                  Icon="@Icons.Material.Filled.People"
                  Subtitle="Administración y monitoreo de credenciales del sistema.">
    <PrimaryActions>
        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenAddModal" Class="btn-info-gradient">Invitar Usuario</MudButton>
    </PrimaryActions>
</MedFarPageHeader>

<div class="mt-4">
    <MedFarTable TItem="MedFarLab.Pwa.Pages.Admin.Identity.UsersList.MockUser"
                 Items="@mockUsers"
                 IsLoading="@IsLoading"
                 ShowSearch="true"
                 SearchPlaceholder="Buscar por nombre o correo..."
                 SearchFilter="@FilterFunc"
                 ColumnCount="7"
                 EmptyTitle="Sin Usuarios"
                 EmptyMessage="No hay usuarios registrados en el sistema.">
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Correo Electrónico</MudTh>
            <MudTh>Nombres (Person)</MudTh>
            <MudTh>Teléfono</MudTh>
            <MudTh>Estatus</MudTh>
            <MudTh>Org. Vinculada</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">@context.Id</MudTd>
            <MudTd DataLabel="Correo Electrónico">@context.Email</MudTd>
            <MudTd DataLabel="Nombres (Person)">
                <div class="d-flex align-center">
                    <MudAvatar Size="Size.Small" Color="Color.Secondary" Class="mr-2">@(context.Name.Length > 0 ? context.Name.Substring(0,1) : "")</MudAvatar>
                    <span>@context.Name</span>
                </div>
            </MudTd>
            <MudTd DataLabel="Teléfono">@context.PhoneNumber</MudTd>
            <MudTd DataLabel="Estatus">
                <MudChip T="string" Color="@Color.Success" Size="Size.Small" Variant="Variant.Outlined">Activo</MudChip>
            </MudTd>
            <MudTd DataLabel="Org. Vinculada">
                <MudLink Typo="Typo.body2">@context.OrgId</MudLink>
            </MudTd>
            <MudTd DataLabel="Acciones">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info" OnClick="@(() => OpenEditModal(context))"/>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteUser(context))"/>
            </MudTd>
        </RowTemplate>
    </MedFarTable>
</div>
