@page "/admin/menus"
@using MedFarLab.Pwa.Shared.Components

<PageTitle>Gestor de Menús Dinámicos</PageTitle>

<MedFarPageHeader Title="Gestor de Menús Dinámicos"
                  Icon="@Icons.Material.Filled.Menu"
                  Subtitle="Parametrización de accesos directos por tipo de organización."
                  ShowBack="true"
                  OnBackClick='() => NavManager.NavigateTo("/admin/dashboard")'>
    <PrimaryActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNewDialog" Class="btn-emerald-gradient">
            Nuevo Menú
        </MudButton>
    </PrimaryActions>
</MedFarPageHeader>

<MudGrid Class="mt-4">
    <MudItem xs="12">
        <MudSelect T="int" Label="Filtrar por Tipo de Organización" ValueChanged="OnOrgTypeChanged" Value="SelectedOrgTypeId" Variant="Variant.Outlined" Class="mb-4 bg-white">
            <MudSelectItem T="int" Value="0">Todas las organizaciones...</MudSelectItem>
            <MudSelectItem T="int" Value="124">Clínica / Sector Médico</MudSelectItem>
            <MudSelectItem T="int" Value="125">Farmacia</MudSelectItem>
            <MudSelectItem T="int" Value="15">Laboratorio</MudSelectItem>
        </MudSelect>
    </MudItem>

    <MudItem xs="12">
        <MedFarTable TItem="MedfarLabs.Core.Application.Features.System.Dtos.NavigationMenuResponseDTO"
                     Items="@MenusList"
                     IsLoading="@IsLoading"
                     ShowSearch="true"
                     SearchFilter="@FilterFunc"
                     SearchPlaceholder="Buscar menú por título o ruta..."
                     ColumnCount="5"
                     EmptyTitle="Sin Menús"
                     EmptyMessage="No hay menús registrados para este tipo de organización.">
            <HeaderContent>
                <MudTh>Icono</MudTh>
                <MudTh>Título Visible</MudTh>
                <MudTh>Ruta (URL)</MudTh>
                <MudTh>Orden</MudTh>
                <MudTh>Acciones</MudTh>
            </HeaderContent>
            <RowTemplate Context="context">
                <MudTd DataLabel="Icono"><MudIcon Icon="@context.Icon" Color="Color.Secondary" /></MudTd>
                <MudTd DataLabel="Título Visible" Style="font-weight: 500;">@context.Title</MudTd>
                <MudTd DataLabel="Ruta (URL)" Class="text-muted">@context.Route</MudTd>
                <MudTd DataLabel="Orden">
                    <MudChip T="string" Color="Color.Dark" Size="Size.Small">@context.OrderIndex</MudChip>
                </MudTd>
                <MudTd DataLabel="Acciones">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditDialog(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" />
                </MudTd>
            </RowTemplate>
        </MedFarTable>
    </MudItem>
</MudGrid>

<MudDialog @bind-Visible="ShowDialog" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>
        <span class="fw-bold">@(MenuModel.Id == 0 ? "Crear Nuevo Entorno Menú" : "Modificar Menú Existente")</span>
    </TitleContent>
    <DialogContent>
        <EditForm Model="MenuModel" OnValidSubmit="SaveMenu">
            <MudSelect T="MedfarLabs.Core.Domain.Enums.TipoOrganizacion" @bind-Value="MenuModel.OrganizationTypeId" Label="Aplica a" Variant="Variant.Outlined" Class="mb-3">
                <MudSelectItem T="MedfarLabs.Core.Domain.Enums.TipoOrganizacion" Value="(MedfarLabs.Core.Domain.Enums.TipoOrganizacion)0" Disabled="true">Seleccione una organización...</MudSelectItem>
                <MudSelectItem T="MedfarLabs.Core.Domain.Enums.TipoOrganizacion" Value="(MedfarLabs.Core.Domain.Enums.TipoOrganizacion)124">Clínica (CLI)</MudSelectItem>
                <MudSelectItem T="MedfarLabs.Core.Domain.Enums.TipoOrganizacion" Value="(MedfarLabs.Core.Domain.Enums.TipoOrganizacion)125">Farmacia (PHA)</MudSelectItem>
                <MudSelectItem T="MedfarLabs.Core.Domain.Enums.TipoOrganizacion" Value="(MedfarLabs.Core.Domain.Enums.TipoOrganizacion)15">Laboratorio (LAB)</MudSelectItem>
            </MudSelect>

            <MudTextField @bind-Value="MenuModel.Title" Label="Etiqueta del Menú" Placeholder="Ej. Mis Pacientes" Variant="Variant.Outlined" Class="mb-3" Required />
            <MudTextField @bind-Value="MenuModel.Route" Label="URL Interna" Placeholder="Ej. /patients/list" Variant="Variant.Outlined" Class="mb-3" Required />
            <MudTextField @bind-Value="MenuModel.Icon" Label="Ícono (MudBlazor)" Placeholder="Icons.Material.Filled.Person" Variant="Variant.Outlined" Class="mb-3" />
            
            <MudNumericField @bind-Value="MenuModel.OrderIndex" Label="Peso de Orden" Variant="Variant.Outlined" Class="mb-3" Min="0" Max="100" />
            
            <div class="d-flex justify-end pt-3">
                <MudButton OnClick="CloseDialog" Class="mr-2">Cancelar</MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="IsSaving">
                    @(IsSaving ? "Guardando..." : "Confirmar Cambios")
                </MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>
