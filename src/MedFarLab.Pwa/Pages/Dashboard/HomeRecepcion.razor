@page "/home/recepcion"
@using MudBlazor
@using MedFarLab.Pwa.Shared.Components.Dashboard

<div class="mf-dashboard">

    <div class="mf-dashboard-greeting mb-6">
        <MudText Typo="Typo.h5">Panel de Recepción 🗂️</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Cierre de caja — @FechaHoy
        </MudText>
    </div>

    <!-- KPIs de caja -->
    <MudGrid Spacing="3" Class="mb-6">
        <MudItem xs="12" sm="6" lg="3">
            <MedFarStatCard Label="Ingresos del día"
                            Value="@($"${TotalEfectivo + TotalTarjeta:N2}")"
                            Icon="@Icons.Material.Filled.AttachMoney"
                            IconColor="#10B981" IconBg="rgba(16,185,129,0.12)"
                            IsLoading="@Cargando"/>
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <MedFarStatCard Label="Efectivo"
                            Value="@($"${TotalEfectivo:N2}")"
                            Icon="@Icons.Material.Filled.Money"
                            IconColor="#6366F1" IconBg="rgba(99,102,241,0.12)"
                            IsLoading="@Cargando"/>
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <MedFarStatCard Label="Tarjeta"
                            Value="@($"${TotalTarjeta:N2}")"
                            Icon="@Icons.Material.Filled.CreditCard"
                            IconColor="#3B82F6" IconBg="rgba(59,130,246,0.12)"
                            IsLoading="@Cargando"/>
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <MedFarStatCard Label="Facturas pendientes"
                            Value="@FacturasPendientes.ToString()"
                            Icon="@Icons.Material.Filled.Receipt"
                            IconColor="#F97316" IconBg="rgba(249,115,22,0.12)"
                            IsLoading="@Cargando"
                            OnClick="@IrAFacturacion"/>
        </MudItem>
    </MudGrid>

    <!-- Resumen por método de pago -->
    @if (FilasCierre?.Any() == true)
    {
        <MudCard Class="surface-glass shadow-float mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Desglose de caja</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIconButton Icon="@Icons.Material.Filled.Print"
                                   OnClick="@ImprimirCierre"/>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudSimpleTable>
                    <thead>
                        <tr>
                            <th>Método</th>
                            <th style="text-align:right">Transacciones</th>
                            <th style="text-align:right">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in FilasCierre)
                        {
                            <tr>
                                <td>@f.PaymentMethod</td>
                                <td style="text-align:right">@f.PaymentCount</td>
                                <td style="text-align:right"><b>$@f.TotalAmount.ToString("N2")</b></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudCardContent>
        </MudCard>
    }
</div>
