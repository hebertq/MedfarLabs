@page "/home"
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject NavigationManager Nav

@* Redirige al dashboard correcto según el rol del usuario *@

@code {
    protected override async Task OnInitializedAsync()
    {
        var storedOrgType = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "medfarlab_orgtype");
        var destino = storedOrgType switch
        {
            "15" => "/laboratory/dashboard",   // Laboratorio
            "125" => "/pharmacy/dashboard",      // Farmacia
            _ => "/clinical/dashboard"             // Clínica por defecto (124)
        };
        Nav.NavigateTo(destino, replace: true);
    }
}
