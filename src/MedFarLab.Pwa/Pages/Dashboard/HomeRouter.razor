@page "/"
@page "/home"
@inject MedfarLabs.Core.Domain.Interfaces.Security.IUserContext UserCtx
@inject NavigationManager Nav

@* Redirige al dashboard correcto según el rol del usuario *@

@code {
    protected override void OnInitialized()
    {
        var destino = UserCtx.OrganizationTypeId switch
        {
            1 or 3 or 5 => "/home/medico",       // Clínica, Médico Independiente, Odontología
            2           => "/home/laboratorio",   // Laboratorio
            4           => "/home/farmacia",      // Farmacia
            _           => "/home/medico"
        };
        Nav.NavigateTo(destino, replace: true);
    }
}
