@page "/laboratory/samples"
@using MedFarLab.Pwa.Shared.Components
@inherits ComponentBase

<PageTitle>Registro de Muestras Clínicas - MedFarLab</PageTitle>

<MedFarPageHeader Title="Registro de Muestras Clínicas"
                  Icon="@Icons.Material.Filled.Science"
                  Subtitle="Gestión integral de preanalítica, códigos de barras y trazabilidad de muestras biológicas.">
    <PrimaryActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.QrCodeScanner"
                   Class="btn-emerald-gradient">
            Leer Etiqueta
        </MudButton>
    </PrimaryActions>
    <SecondaryActions>
        <MudMenuItem Icon="@Icons.Material.Filled.Add" OnClick="OpenReceiveSampleDialog">Recibir Muestra</MudMenuItem>
    </SecondaryActions>
</MedFarPageHeader>

<MedFarTable TItem="SampleRecord"
             Items="@MockSamples"
             IsLoading="@IsLoading"
             SearchFilter="@FilterFunc"
             SearchPlaceholder="Buscar por Código o Nombre..."
             ColumnCount="6"
             EmptyTitle="Inventario Vacío"
             EmptyMessage="No hay muestras registradas para el día de hoy."
             EmptyIcon="@Icons.Material.Filled.Biotech">

    <HeaderContent>
        <MudTh>Código de Barras</MudTh>
        <MudTh>Paciente</MudTh>
        <MudTh>Tipo de Muestra</MudTh>
        <MudTh>Prueba Solicitada</MudTh>
        <MudTh>Estado Preanalítico</MudTh>
        <MudTh>Acciones</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Código de Barras">
            <MudText Typo="Typo.body2" Class="fw-bold" Color="Color.Secondary">@context.Barcode</MudText>
        </MudTd>
        <MudTd DataLabel="Paciente">
            <div class="d-flex align-center">
                <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-3">@context.PatientName.Substring(0, 1)</MudAvatar>
                <MudText Typo="Typo.body2">@context.PatientName</MudText>
            </div>
        </MudTd>
        <MudTd DataLabel="Tipo de Muestra">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info" Icon="@Icons.Material.Filled.Bloodtype">@context.SampleType</MudChip>
        </MudTd>
        <MudTd DataLabel="Prueba Solicitada">@context.TestName</MudTd>
        <MudTd DataLabel="Estado Preanalítico">
            @if (context.Status == "Recolectada")
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@context.Status</MudChip>
            }
            else if (context.Status == "Rechazada")
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Error">@context.Status</MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@context.Status</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="Acciones">
            <MudIconButton Icon="@Icons.Material.Filled.Receipt" Color="Color.Primary" Size="Size.Small" Title="Generar Etiqueta" />
            @if(context.Status == "Pendiente") {
                <MudIconButton Icon="@Icons.Material.Filled.FactCheck" Color="Color.Success" Size="Size.Small" Title="Recibir Muestra" OnClick="@(() => ReceiveSample(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" Title="Rechazar" OnClick="@(() => RejectSample(context))" />
            }
        </MudTd>
    </RowTemplate>

</MedFarTable>
