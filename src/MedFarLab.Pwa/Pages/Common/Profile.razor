@page "/user/profile"
@using MudBlazor
@inject MedFarLab.Pwa.State.AppState AppState

<PageTitle>Mi Perfil | MedFarLab</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Mi Perfil</MudText>

<MudCard Class="surface-glass rounded-xl mb-4">
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" md="4" Class="d-flex justify-center align-center">
                <MudAvatar Color="Color.Primary" Style="height: 100px; width: 100px;">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" />
                </MudAvatar>
            </MudItem>
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.h6">@AppState.FullName</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">Usuario: @AppState.Username</MudText>
                <MudText Typo="Typo.body2" Class="mt-2">Roles: @string.Join(", ", AppState.UserRoles)</MudText>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>
