@using MudBlazor

<MudCard Elevation="0" Class="mt-4 border-solid border-1 mud-border-lines-default rounded-lg">
    <MudCardHeader>
        <CardHeaderAvatar>
            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Warning" />
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Gestión Administrativa</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Nivel de acceso y responsabilidades</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Sucursales a Cargo" Value="@("Todas las sucursales")" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Nivel de Acceso" Value="@("Full Access (Nivel 5)")" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>
