@page "/settings/password"
@layout SettingsLayout
@using MudBlazor
@using System.ComponentModel.DataAnnotations
@inject ISnackbar Snackbar

<PageTitle>Seguridad | MedFarLab</PageTitle>

<div class="glass-header mb-4">
    <div>
        <MudText Typo="Typo.h5" Class="text-primary fw-bold">Seguridad y Acceso</MudText>
        <MudText Typo="Typo.body2" Class="text-muted">Actualice su contraseña para proteger su cuenta.</MudText>
    </div>
</div>

<MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
    <MudCard Class="surface-glass rounded-xl mb-4" Elevation="1">
        <MudCardContent Class="pa-6">
            <EditForm Model="@_model" OnValidSubmit="OnValidSubmit">
                <DataAnnotationsValidator />
                
                <MudText Typo="Typo.h6" Class="mb-4">Cambiar Contraseña</MudText>
                
                <MudTextField @bind-Value="_model.CurrentPassword"
                              For="@(() => _model.CurrentPassword)"
                              Label="Contraseña Actual"
                              Variant="Variant.Outlined"
                              InputType="@_currentPasswordInput"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_currentPasswordIcon"
                              OnAdornmentClick="ToggleCurrentPasswordVisibility"
                              AdornmentAriaLabel="Mostrar contraseña"
                              Class="mb-4" />

                <MudTextField @bind-Value="_model.NewPassword"
                              For="@(() => _model.NewPassword)"
                              Label="Nueva Contraseña"
                              Variant="Variant.Outlined"
                              InputType="@_newPasswordInput"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_newPasswordIcon"
                              OnAdornmentClick="ToggleNewPasswordVisibility"
                              AdornmentAriaLabel="Mostrar contraseña"
                              HelperText="Debe tener al menos 8 caracteres."
                              Class="mb-4" />

                <MudTextField @bind-Value="_model.ConfirmPassword"
                              For="@(() => _model.ConfirmPassword)"
                              Label="Confirmar Nueva Contraseña"
                              Variant="Variant.Outlined"
                              InputType="@_newPasswordInput"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_newPasswordIcon"
                              OnAdornmentClick="ToggleNewPasswordVisibility"
                              AdornmentAriaLabel="Mostrar contraseña"
                              Class="mb-6" />

                <div class="d-flex justify-end">
                    <MudButton ButtonType="ButtonType.Submit" 
                               Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               Disabled="@_isProcessing"
                               DisableElevation="true">
                        @if (_isProcessing)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                            <MudText Class="ms-2">Guardando</MudText>
                        }
                        else
                        {
                            <MudText>Actualizar Contraseña</MudText>
                        }
                    </MudButton>
                </div>
            </EditForm>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private PasswordModel _model = new();
    private bool _isProcessing = false;

    private bool _isShowCurrentPassword;
    private InputType _currentPasswordInput = InputType.Password;
    private string _currentPasswordIcon = Icons.Material.Filled.VisibilityOff;

    private bool _isShowNewPassword;
    private InputType _newPasswordInput = InputType.Password;
    private string _newPasswordIcon = Icons.Material.Filled.VisibilityOff;

    private void ToggleCurrentPasswordVisibility()
    {
        _isShowCurrentPassword = !_isShowCurrentPassword;
        _currentPasswordInput = _isShowCurrentPassword ? InputType.Text : InputType.Password;
        _currentPasswordIcon = _isShowCurrentPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private void ToggleNewPasswordVisibility()
    {
        _isShowNewPassword = !_isShowNewPassword;
        _newPasswordInput = _isShowNewPassword ? InputType.Text : InputType.Password;
        _newPasswordIcon = _isShowNewPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private async Task OnValidSubmit()
    {
        _isProcessing = true;
        
        // Simular llamada a la API
        await Task.Delay(1500);
        
        Snackbar.Add("Contraseña actualizada exitosamente.", Severity.Success);
        
        _model = new PasswordModel(); // Limpiar formulario
        _isProcessing = false;
    }

    public class PasswordModel
    {
        [Required(ErrorMessage = "La contraseña actual es obligatoria.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "La nueva contraseña es obligatoria.")]
        [MinLength(8, ErrorMessage = "La contraseña debe tener al menos 8 caracteres.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debe confirmar la contraseña.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
