@inherits LayoutComponentBase
@using MudBlazor
@using MedFarLab.Pwa.Shared.Components
@inject MedFarLab.Pwa.Services.MedFarThemeService ThemeService
@inject MedFarLab.Pwa.Services.MedFarMenuService MenuService
@inject NavigationManager Nav

<MudThemeProvider Theme="@MedFarLab.Pwa.Services.MedFarTheme.Build()" IsDarkMode="@ThemeService.IsDarkMode"/>
<MudSnackbarProvider/>
<MudDialogProvider MaxWidth="MaxWidth.Medium" FullWidth="false" CloseButton="true" BackdropClick="false"/>
<MudPopoverProvider />

@{
    RenderFragment navMenuContent =
    @<MudNavMenu>
        @if (MenuService.SettingsGroups != null && MenuService.SettingsGroups.Any())
        {
            @foreach (var grupo in MenuService.SettingsGroups)
            {
                <div class="mt-4 mb-1 px-4">
                    <MudText Typo="Typo.overline" Color="Color.Secondary">
                        @MenuService.GetGroupLabel(grupo.Key)
                    </MudText>
                </div>
                
                @foreach (var item in grupo)
                {
                    <MudNavLink Href="@item.Route" 
                                Icon="@GetMudIcon(item.Icon)"
                                Match="NavLinkMatch.All">
                        @item.Title
                    </MudNavLink>
                }
            }
        }
        else
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">Cargando...</MudText>
        }
    </MudNavMenu>;
}

<MudLayout Class="@(ThemeService.IsDarkMode ? "theme-dark" : "")">
    <!-- AppBar glassmorphism (Settings Mode) -->
    <MudAppBar Elevation="0" Class="mf-appbar surface-glass">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" 
                       Edge="Edge.Start" 
                       Color="Color.Primary"
                       OnClick="@GoBackToDashboard" 
                       Title="Regresar al Dashboard" />
        <MudIconButton Icon="@Icons.Material.Filled.Menu" 
                       Color="Color.Primary" 
                       Edge="Edge.Start" 
                       OnClick="@DrawerToggle" 
                       Class="d-md-none ml-2" 
                       Title="Menú de Ajustes" />
        <div class="mf-appbar-brand ml-4">
            <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-weight-bold">Ajustes del Sistema</MudText>
        </div>
        <MudSpacer/>
        <MedFarProfileMenu />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="@DrawerVariant.Temporary" ClipMode="DrawerClipMode.Never">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-weight-bold">Opciones</MudText>
        </MudDrawerHeader>
        @navMenuContent
    </MudDrawer>

    <MudMainContent Class="mf-main-content">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            <MudGrid Class="mt-2">
                <!-- Columna Izquierda: Navegación de Ajustes (Oculta en móviles) -->
                <MudItem xs="12" md="3" Class="d-none d-md-block">
                    <MudPaper Elevation="0" Class="pa-4 surface-glass">
                        <MudText Typo="Typo.h6" Class="mb-4 font-weight-bold">Opciones</MudText>
                        @navMenuContent
                    </MudPaper>
                </MudItem>

                <!-- Columna Derecha: Contenido Específico -->
                <MudItem xs="12" md="9">
                    <MudPaper Elevation="0" Class="pa-6 surface-glass h-100">
                        @Body
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen;

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string Subtitle { get; set; } = string.Empty;

    [Inject]
    public MedFarLab.Pwa.Services.IUserContextService UserCtx { get; set; } = null!;

    protected override void OnInitialized()
    {
        ThemeService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
    }

    private void GoBackToDashboard()
    {
        if (UserCtx.IsClinica) Nav.NavigateTo("/clinical/dashboard");
        else if (UserCtx.IsLaboratorio) Nav.NavigateTo("/laboratory/dashboard");
        else if (UserCtx.IsFarmacia) Nav.NavigateTo("/pharmacy/dashboard");
        else Nav.NavigateTo("/");
    }

    private string GetMudIcon(string? iconName)
    {
        if (string.IsNullOrEmpty(iconName)) return Icons.Material.Filled.Circle;
        
        var shortName = iconName.Replace("Icons.Material.Filled.", "");
        
        return shortName switch
        {
            "Person" => Icons.Material.Filled.Person,
            "Lock" => Icons.Material.Filled.Lock,
            "Settings" => Icons.Material.Filled.Settings,
            "Notifications" => Icons.Material.Filled.Notifications,
            "NoteAlt" => Icons.Material.Filled.NoteAlt,
            "Receipt" => Icons.Material.Filled.Receipt,
            "Business" => Icons.Material.Filled.Business,
            "Group" => Icons.Material.Filled.Group,
            "Science" => Icons.Material.Filled.Science,
            "Biotech" => Icons.Material.Filled.Biotech,
            "LocalPharmacy" => Icons.Material.Filled.LocalPharmacy,
            "Dashboard" => Icons.Material.Filled.Dashboard,
            "Key" => Icons.Material.Filled.Key,
            "Assignment" => Icons.Material.Filled.Assignment,
            "Print" => Icons.Material.Filled.Print,
            "Storefront" => Icons.Material.Filled.Storefront,
            "Schedule" => Icons.Material.Filled.Schedule,
            "MonitorHeart" => Icons.Material.Filled.MonitorHeart,
            _ => Icons.Material.Filled.SettingsApplications
        };
    }
}
