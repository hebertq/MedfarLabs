@page "/billing/daily-closing"
@using MudBlazor
@using MedFarLab.Pwa.Pages.Billing.Models

<PageTitle>Cierre Diario - MedFarLab</PageTitle>

<PageActionHeader Sticky="false">
    <ActionContent>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadDataAsync">
            Actualizar
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Lock" OnClick="CloseBillingPeriodAsync" Disabled="@IsLoading">
            Cerrar Periodo
        </MudButton>
    </ActionContent>
</PageActionHeader>

<div class="glass-header mb-4 d-flex justify-space-between align-center">
    <div>
        <MudText Typo="Typo.h5" Class="text-primary fw-bold">Cierre Diario de Caja</MudText>
        <MudText Typo="Typo.body2" Class="text-muted">Revise los pagos del día agrupados por método de pago y ejecute el cierre de periodo.</MudText>
    </div>
    <div>
        <MudDatePicker @bind-Date="FilterDate" Label="Fecha de Cierre" DateFormat="dd/MM/yyyy" Class="mt-0" />
    </div>
</div>

@if (IsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
}
else
{
    <MudGrid>
        @if (ClosingRows == null || !ClosingRows.Any())
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Variant="Variant.Filled">No se encontraron movimientos para la fecha seleccionada.</MudAlert>
            </MudItem>
        }
        else
        {
            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Style="border: 1px solid var(--mud-palette-lines-default); border-radius: 8px;">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Resumen General</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.h3" Class="text-primary fw-bold text-center mb-4">
                            $@TotalAmount.ToString("N2")
                        </MudText>
                        <MudText Typo="Typo.body1" Class="text-center text-muted">
                            Total Recaudado (@ClosingRows.Sum(x => x.Count) transacciones)
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudDataGrid Items="@ClosingRows" Hover="true" Elevation="0" Dense="true" Style="border: 1px solid var(--mud-palette-lines-default); border-radius: 8px;">
                    <Columns>
                        <PropertyColumn Property="x => x.PaymentMethod" Title="Método de Pago">
                            <CellTemplate>
                                <div class="d-flex align-center">
                                    <MudIcon Icon="@GetIconForMethod(context.Item.PaymentMethod)" Class="mr-3 text-muted" />
                                    <MudText Typo="Typo.body1" Class="fw-bold">@context.Item.PaymentMethod</MudText>
                                </div>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Count" Title="Transacciones" />
                        <PropertyColumn Property="x => x.TotalAmount" Title="Monto Total">
                            <CellTemplate>
                                <MudText Typo="Typo.body1" Class="fw-bold text-success">$@context.Item.TotalAmount.ToString("N2")</MudText>
                            </CellTemplate>
                        </PropertyColumn>
                    </Columns>
                </MudDataGrid>
            </MudItem>
        }
    </MudGrid>
}
