@page "/billing/history"
@page "/billing/invoices"
@using MedFarLab.Pwa.Shared.Components
@inherits ComponentBase

<PageTitle>Directorio de Facturas - MedFarLab</PageTitle>

<MedFarPageHeader Title="Directorio de Facturación"
                  Icon="@Icons.Material.Filled.Receipt"
                  Subtitle="Explorar el registro histórico de facturas emitidas y cerradas.">
    <PrimaryActions>
        <MudButton Href="/billing/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="btn-emerald-gradient">
            Emitir Nueva
        </MudButton>
    </PrimaryActions>
    <SecondaryActions>
        <MudMenuItem OnClick="ExportToExcelAsync">
            <div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.FileDownload" Class="mr-2"/> Exportar a Excel (CSV)</div>
        </MudMenuItem>
    </SecondaryActions>
</MedFarPageHeader>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6 mt-4" Style="background: white; border: 1px solid var(--mud-palette-lines-default);">
    <MudTabPanel Text="Facturas Pendientes" Icon="@Icons.Material.Filled.AccessTime">
        <MedFarTable TItem="MedFarLab.Pwa.Pages.Billing.InvoiceHistoryDto"
                     Items="@PendingInvoices"
                     IsLoading="@IsLoading"
                     ShowSearch="true"
                     SearchPlaceholder="Buscar por nombre o número..."
                     SearchFilter="@FilterFunc"
                     ColumnCount="6"
                     EmptyTitle="Sin Facturas Pendientes"
                     EmptyMessage="No hay facturas pendientes de cobro.">
            <HeaderContent>
                <MudTh>N° Factura</MudTh>
                <MudTh>Fecha</MudTh>
                <MudTh>Paciente</MudTh>
                <MudTh>Monto a Cobrar</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh>Acción</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="N° Factura">@context.InvoiceNumber</MudTd>
                <MudTd DataLabel="Fecha">@context.IssuedDate.ToString("dd MMM yyyy HH:mm")</MudTd>
                <MudTd DataLabel="Paciente">@context.PatientName</MudTd>
                <MudTd DataLabel="Monto a Cobrar">
                    <MudText Typo="Typo.body2" Class="fw-bold text-warning">$@context.TotalAmount.ToString("0.00")</MudText>
                </MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Por Pagar</MudChip>
                </MudTd>
                <MudTd DataLabel="Acción">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Href="@($"/billing/invoice/{@context.InvoiceId}")">
                        Procesar Factura
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MedFarTable>
    </MudTabPanel>
    
    <MudTabPanel Text="Historial (Pagadas)" Icon="@Icons.Material.Filled.History">
        <MedFarTable TItem="MedFarLab.Pwa.Pages.Billing.InvoiceHistoryDto"
                     Items="@Invoices"
                     IsLoading="@IsLoading"
                     ShowSearch="true"
                     SearchPlaceholder="Buscar por nombre o número..."
                     SearchFilter="@FilterFunc"
                     ColumnCount="6"
                     EmptyTitle="Sin Historial"
                     EmptyMessage="No se encontraron facturas pagadas en el historial.">
            <HeaderContent>
                <MudTh>N° Factura</MudTh>
                <MudTh>Fecha</MudTh>
                <MudTh>Paciente</MudTh>
                <MudTh>Monto Pagado</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh>Acción</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="N° Factura">@context.InvoiceNumber</MudTd>
                <MudTd DataLabel="Fecha">@context.IssuedDate.ToString("dd MMM yyyy HH:mm")</MudTd>
                <MudTd DataLabel="Paciente">@context.PatientName</MudTd>
                <MudTd DataLabel="Monto Pagado">
                    <MudText Typo="Typo.body2" Class="fw-bold text-success">$@context.TotalAmount.ToString("0.00")</MudText>
                </MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Pagada</MudChip>
                </MudTd>
                <MudTd DataLabel="Acción">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Href="@($"/billing/view/{@context.InvoiceId}")">
                        Ver o Imprimir
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MedFarTable>
    </MudTabPanel>
</MudTabs>
