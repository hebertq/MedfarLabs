@page "/patients/directory"
@using MedFarLab.Application.Features.Patient.Queries.GetPatientDirectory
@using MedFarLab.Application.Features.Clinical.Models
@using MedFarLab.Pwa.Shared.Components
@inherits ComponentBase

<PageTitle>Directorio de Pacientes - MedFarLab</PageTitle>

<MedFarPageHeader Title="Directorio de Pacientes"
                  Icon="@Icons.Material.Filled.People"
                  Subtitle="@($"{PatientsList.Count} pacientes registrados")">
    <PrimaryActions>
        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   Class="btn-emerald-gradient"
                   OnClick="CheckInPatient">
            Nuevo Paciente
        </MudButton>
    </PrimaryActions>
    <SecondaryActions>
        <MudMenuItem Icon="@Icons.Material.Filled.PersonSearch"
                     OnClick="OpenGlobalSearch">BÃºsqueda Global</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.FileDownload"
                     OnClick="ExportarCSV">Exportar a CSV</MudMenuItem>
    </SecondaryActions>
</MedFarPageHeader>

<MedFarTable TItem="PatientDirectoryVM"
             Items="@PatientsList"
             IsLoading="@IsLoading"
             SearchFilter="@FiltrarPaciente"
             SearchPlaceholder="Buscar por nombre o documento..."
             ColumnCount="4"
             EmptyTitle="@MedFarEmptyState.Patients.Title"
             EmptyMessage="@MedFarEmptyState.Patients.Message"
             EmptyIcon="@MedFarEmptyState.Patients.Icon">

    <HeaderContent>
        <MudTh>Paciente</MudTh>
        <MudTh>IdentificaciÃ³n</MudTh>
        <MudTh>Ãšltima InteracciÃ³n</MudTh>
        <MudTh>Acciones</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>
            <div class="d-flex align-center gap-3">
                <MudAvatar Color="Color.Primary" Size="Size.Small">
                    @(!string.IsNullOrEmpty(context.FullName) ? context.FullName[0] : '?')
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.body2" Class="font-weight-bold">@context.FullName</MudText>
                </div>
            </div>
        </MudTd>
        <MudTd>@context.DocumentId</MudTd>
        <MudTd>@* AquÃ­ podrÃ­a ir la fecha de Ãºltima visita *@ â€” </MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="@(() => OpenRecord(context.Id.ToString()))"/>
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Size="Size.Small"
                           Color="Color.Default"
                           OnClick="@(() => EditarPaciente(context.Id.ToString()))"/>
        </MudTd>
    </RowTemplate>

    <EmptyActionContent>
        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   Class="btn-emerald-gradient"
                   OnClick="CheckInPatient">
            Registrar primer paciente
        </MudButton>
    </EmptyActionContent>

</MedFarTable>
