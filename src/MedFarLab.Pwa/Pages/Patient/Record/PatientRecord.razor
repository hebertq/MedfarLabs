@page "/patients/record/{PatientId}"
@using MedFarLab.Pwa.Shared.Components
@using MedFarLab.Pwa.Shared.Clinical
@using MedFarLab.Application.Features.Patient.Models
@inherits ComponentBase

<PageTitle>Expediente - MedFarLab</PageTitle>

@if (IsLoading)
{
    <MedFarSkeleton Type="MedFarSkeletonType.PatientHeader" />
}
else if (Patient != null)
{
    <MedFarPageHeader Title="@Patient.FullName"
                      Icon="@Icons.Material.Filled.AssignmentInd"
                      Subtitle="@($"DNI: {Patient.Identifier} | Edad: {Patient.Age} años | Género: {Patient.Gender}")"
                      ShowBack="true"
                      OnBackClick="VolverAlDirectorio">
        <PrimaryActions>
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.LocalHospital"
                       Class="btn-emerald-gradient"
                       OnClick="NuevaConsulta">
                Nueva Consulta
            </MudButton>
        </PrimaryActions>
        <SecondaryActions>
            <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="EditarPaciente">Editar datos</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Print" OnClick="ImprimirExpediente">Imprimir expediente</MudMenuItem>
        </SecondaryActions>
    </MedFarPageHeader>

    <!-- TOP CLINICAL ALERTS -->
    @if (PatientAllergies.Any() || CriticalRiskAlerts.Any() || (Patient.ActivePrescriptions != null && Patient.ActivePrescriptions.Any()))
    {
        <MudPaper Class="d-flex flex-column flex-md-row align-start align-md-center pa-4 mb-6 shadow-float" Style="border-left: 6px solid var(--mud-palette-error); border-radius: 12px; background-color: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px);">
            <div class="d-flex align-center mr-6 mb-3 mb-md-0" style="min-width: 180px;">
                <MudIcon Icon="@Icons.Material.Filled.MedicalInformation" Color="Color.Error" Size="Size.Large" Class="mr-3" />
                <MudText Typo="Typo.h6" Style="font-weight: 600; color: var(--mud-palette-dark);">Atención Clínica</MudText>
            </div>
            
            <MudGrid Spacing="2">
                @if (PatientAllergies.Any())
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Class="text-muted d-block">Alergias</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Error" Style="font-weight: 600;">@string.Join(", ", PatientAllergies)</MudText>
                    </MudItem>
                }
                @if (CriticalRiskAlerts.Any())
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Class="text-muted d-block">Riesgos Críticos</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight: 500; color: var(--mud-palette-dark);">@string.Join(", ", CriticalRiskAlerts)</MudText>
                    </MudItem>
                }
                @if (Patient.ActivePrescriptions != null && Patient.ActivePrescriptions.Any())
                {
                    <MudItem xs="12" sm="12" md="4">
                        <MudText Typo="Typo.caption" Class="text-muted d-block">Medicamentos Activos</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight: 500; color: var(--mud-palette-dark);">@string.Join(", ", Patient.ActivePrescriptions.Select(p => p.MedicationName))</MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    }
    else
    {
        <StickyPatientAlerts Allergies="@PatientAllergies" CriticalAlerts="@CriticalRiskAlerts" />
    }

    <MudGrid Class="mt-4 fade-in" Spacing="4">
        @* Left Column: Consultations Timeline *@
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4 surface-glass shadow-float h-100">
                <div class="d-flex align-center mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Article" Color="Color.Primary" Class="mr-2" />
                    <MudText Typo="Typo.h6">Historial de Consultas</MudText>
                </div>
                <MedFarTimeline Consultations="@Patient.Consultations"
                                OnVerDetalle="@VerConsulta"/>
            </MudPaper>
        </MudItem>

        @* Right Column: Widgets (Vitals, Prescriptions, Antecedents) *@
        <MudItem xs="12" md="4">
            <MudGrid Spacing="4">
                
                @* Widget 1: Medidas Recientes *@
                <MudItem xs="12">
                    <MudPaper Class="pa-4 surface-glass shadow-float">
                        <div class="d-flex align-center mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.AccessibilityNew" Color="Color.Success" Class="mr-2" />
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Medidas Recientes</MudText>
                        </div>
                        <MudGrid Spacing="2">
                            <MudItem xs="4">
                                <MudText Typo="Typo.caption" Class="text-muted d-block">Peso</MudText>
                                <MudText Typo="Typo.body2" Class="font-weight-bold">@(string.IsNullOrWhiteSpace(Patient.Weight) ? "--" : Patient.Weight)</MudText>
                            </MudItem>
                            <MudItem xs="4">
                                <MudText Typo="Typo.caption" Class="text-muted d-block">Altura</MudText>
                                <MudText Typo="Typo.body2" Class="font-weight-bold">@(string.IsNullOrWhiteSpace(Patient.Height) ? "--" : Patient.Height)</MudText>
                            </MudItem>
                            <MudItem xs="4">
                                <MudText Typo="Typo.caption" Class="text-muted d-block">Temp.</MudText>
                                <MudText Typo="Typo.body2" Class="font-weight-bold" Color="Color.Error">@(string.IsNullOrWhiteSpace(Patient.Temperature) ? "--" : Patient.Temperature)</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>

                @* Widget 2: Antecedentes *@
                <MudItem xs="12">
                    <MudPaper Class="pa-4 surface-glass shadow-float">
                        <div class="d-flex align-center justify-space-between mb-3">
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Warning" Class="mr-2" />
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Antecedentes</MudText>
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary" OnClick="@AbrirModalAntecedente" />
                        </div>
                        
                        @if (Patient.Antecedents == null || !Patient.Antecedents.Any())
                        {
                            <MudText Typo="Typo.body2" Class="text-muted">No hay antecedentes registrados.</MudText>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3 mt-2">
                                @foreach (var ant in Patient.Antecedents)
                                {
                                    <div class="d-flex align-start">
                                        <MudIcon Icon="@Icons.Material.Filled.Bookmark" Size="Size.Small" Color="Color.Secondary" Class="mr-2 mt-1" />
                                        <div>
                                            <div class="mb-1">
                                                <MudChip T="string" Size="Size.Small" Color="@(ant.TypeName.Contains("Alergi", StringComparison.OrdinalIgnoreCase) ? Color.Error : Color.Primary)" Variant="Variant.Outlined" Class="ma-0">@ant.TypeName</MudChip>
                                            </div>
                                            <MudText Typo="Typo.body2">@ant.Description</MudText>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </MudPaper>
                </MudItem>

                @* Widget 3: Vitales *@
                <MudItem xs="12">
                    <MudPaper Class="pa-4 surface-glass shadow-float">
                        <div class="d-flex align-center mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Color="Color.Secondary" Class="mr-2" />
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Evolución de Vitales</MudText>
                        </div>
                        @if (VitalsSeries.Any())
                        {
                            <MudChart ChartType="ChartType.Line"
                                      ChartSeries="@VitalsSeries"
                                      XAxisLabels="@VitalsLabels"
                                      Width="100%" Height="200px"/>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="text-muted">Sin registros de signos vitales.</MudText>
                        }
                    </MudPaper>
                </MudItem>

            </MudGrid>
        </MudItem>
    </MudGrid>
}
else
{
    <MedFarEmptyState Title="Paciente no encontrado" Message="El expediente que intentas visualizar no existe." />
}
