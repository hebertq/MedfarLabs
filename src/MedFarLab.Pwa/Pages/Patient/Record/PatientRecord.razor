@page "/patients/record/{PatientId}"
@using MedFarLab.Pwa.Shared.Components
@using MedFarLab.Pwa.Shared.Clinical
@using MedFarLab.Application.Features.Patient.Models
@inherits ComponentBase

<PageTitle>Expediente - MedFarLab</PageTitle>

@if (IsLoading)
{
    <MedFarSkeleton Type="MedFarSkeletonType.PatientHeader" />
}
else if (Patient != null)
{
    <MedFarPageHeader Title="@Patient.FullName"
                      Icon="@Icons.Material.Filled.AssignmentInd"
                      Subtitle="@($"DNI: {Patient.Identifier} | Edad: {Patient.Age} años | Género: {Patient.Gender}")"
                      ShowBack="true"
                      OnBackClick="VolverAlDirectorio">
        <PrimaryActions>
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.LocalHospital"
                       Class="btn-emerald-gradient"
                       OnClick="NuevaConsulta">
                Nueva Consulta
            </MudButton>
        </PrimaryActions>
        <SecondaryActions>
            <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="EditarPaciente">Editar datos</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Print" OnClick="ImprimirExpediente">Imprimir expediente</MudMenuItem>
        </SecondaryActions>
    </MedFarPageHeader>

    <StickyPatientAlerts Allergies="@PatientAllergies" CriticalAlerts="@CriticalRiskAlerts" />

    <MudGrid Class="mt-4">
        <!-- Resumen Clínico -->
        <MudItem xs="12" md="4">
            <MudCard Class="surface-glass shadow-float mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Resumen Clínico</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudText><b>Tipo de Sangre:</b> @Patient.BloodType</MudText>
                    
                    @if (Patient.BloodPressureSystolic != null && Patient.BloodPressureSystolic.Any())
                    {
                        <MudText><b>Última Presión Arterial:</b> @Patient.BloodPressureSystolic.LastOrDefault() / @Patient.BloodPressureDiastolic.LastOrDefault()</MudText>
                    }
                    
                    @if (Patient.Allergies != null && Patient.Allergies.Any())
                    {
                        <MudText Class="mt-2" Color="Color.Error"><b>Alergias:</b> @string.Join(", ", Patient.Allergies)</MudText>
                    }

                    @if (Patient.Antecedents != null && Patient.Antecedents.Any())
                    {
                        <MudText Class="mt-2"><b>Antecedentes:</b></MudText>
                        <ul style="padding-left: 20px;">
                            @foreach (var ant in Patient.Antecedents)
                            {
                                <li>@ant.Description (@ant.TypeName)</li>
                            }
                        </ul>
                    }
                    
                    @if (Patient.ActivePrescriptions != null && Patient.ActivePrescriptions.Any())
                    {
                        <MudText Class="mt-2"><b>Recetas Activas:</b></MudText>
                        <ul style="padding-left: 20px;">
                            @foreach (var p in Patient.ActivePrescriptions)
                            {
                                <li>@p.MedicationName - @p.Dosage</li>
                            }
                        </ul>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Historial de Consultas (Uso de MedFarTable con Densidad) -->
        <MudItem xs="12" md="8">
            <MedFarTable TItem="ClinicalHistoryItemVM"
                         Items="@Consultas"
                         IsLoading="false"
                         Dense="true"
                         ShowSearch="false"
                         ColumnCount="4"
                         EmptyTitle="Sin consultas"
                         EmptyMessage="Este paciente aún no tiene consultas registradas."
                         EmptyIcon="@Icons.Material.Filled.EventBusy">
                <HeaderContent>
                    <MudTh>Fecha</MudTh>
                    <MudTh>Motivo</MudTh>
                    <MudTh>Médico</MudTh>
                    <MudTh>Acciones</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Date.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd>@context.Title</MudTd>
                    <MudTd>@context.DoctorName</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" Size="Size.Small" OnClick="@(() => VerConsulta(context.ConsultationId))" />
                    </MudTd>
                </RowTemplate>
            </MedFarTable>
        </MudItem>
    </MudGrid>
}
else
{
    <MedFarEmptyState Title="Paciente no encontrado" Message="El expediente que intentas visualizar no existe." />
}
