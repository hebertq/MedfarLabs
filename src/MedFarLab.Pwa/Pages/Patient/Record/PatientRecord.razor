@page "/patients/record/{Id}"
@using MudBlazor

<PageTitle>Expediente 360° - MedFarLab</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-10">
    <style>
        .mud-chart text {
            font-size: 20px !important;
            font-weight: 700 !important;
            fill: #334155 !important;
        }
    </style>
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack">
                Regresar
            </MudButton>
            <MudText Typo="Typo.h5" Class="mt-2 text-primary fw-bold">Visión 360° del Paciente</MudText>
        </div>
        <div>
            <!-- Resguardado para futura edición de perfil demográfico (Teléfono, Dirección, Estado Civil, etc) -->
            <!-- <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Editar</MudButton> -->
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="d-flex flex-column align-center justify-center" style="min-height: 400px;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mb-4" />
            <MudText Typo="Typo.h5" Color="Color.Primary">Cargando Expediente...</MudText>
        </div>
    }
    else
    {
        <MudGrid>
            <!-- COLUMNA IZQUIERDA: Info General y Vitals -->
            <MudItem xs="12" md="4">
                <!-- Patient Profile -->
                <MudPaper Class="pa-6 rounded-xl mb-6" Elevation="2" Style="background: linear-gradient(135deg, var(--mud-palette-surface) 0%, rgba(16, 185, 129, 0.05) 100%);">
                    <div class="d-flex align-center mb-4">
                        <MudAvatar Color="Color.Primary" Size="Size.Large" Variant="Variant.Filled" Style="width: 70px; height: 70px; font-size: 1.8rem; box-shadow: 0px 4px 10px rgba(0,0,0,0.1);">
                            @Model.Initials
                        </MudAvatar>
                        <div class="ml-4">
                            <MudText Typo="Typo.h6"><b>@Model.FullName</b></MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@Model.Gender, @Model.Age Años</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">ID: @Model.Identifier</MudText>
                        </div>
                    </div>
                    
                    <MudDivider Class="my-4"/>
                    
                    <MudGrid>
                        <MudItem xs="12">
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.WaterDrop" Color="Color.Error" Size="Size.Small" Class="mr-2" />
                                <MudText Typo="Typo.subtitle1">Grupo Sanguíneo: <b>@Model.BloodType</b></MudText>
                            </div>
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-4"/>

                    <div class="d-flex justify-space-between align-center mb-2">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Primary">Antecedentes Clínicos</MudText>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAntecedentModal">Añadir</MudButton>
                    </div>

                    <MudList T="string" Dense="true" Class="pa-0">
                        @if (Model.Antecedents.Any(a => a.TypeId == 2))
                        {
                            <MudListItem Icon="@Icons.Material.Filled.Warning" IconColor="Color.Error" Class="px-0">
                                <MudText Typo="Typo.caption" Color="Color.Secondary"><b>Alergias Letales</b></MudText>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach(var ant in Model.Antecedents.Where(a => a.TypeId == 2))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">@ant.Description</MudChip>
                                    }
                                </div>
                            </MudListItem>
                        }
                        
                        @if (Model.Antecedents.Any(a => a.TypeId == 1))
                        {
                            <MudListItem Icon="@Icons.Material.Filled.MedicalServices" IconColor="Color.Warning" Class="px-0">
                                <MudText Typo="Typo.caption" Color="Color.Secondary"><b>Patológicos</b></MudText>
                                <div class="mt-1">
                                    @foreach(var ant in Model.Antecedents.Where(a => a.TypeId == 1))
                                    {
                                        <MudText Typo="Typo.body2">• @ant.Description</MudText>
                                    }
                                </div>
                            </MudListItem>
                        }

                        @if (Model.Antecedents.Any(a => a.TypeId == 3))
                        {
                            <MudListItem Icon="@Icons.Material.Filled.FamilyRestroom" IconColor="Color.Info" Class="px-0">
                                <MudText Typo="Typo.caption" Color="Color.Secondary"><b>Familiares</b></MudText>
                                <div class="mt-1">
                                    @foreach(var ant in Model.Antecedents.Where(a => a.TypeId == 3))
                                    {
                                        <MudText Typo="Typo.body2">• @ant.Description</MudText>
                                    }
                                </div>
                            </MudListItem>
                        }

                        @if (!Model.Antecedents.Any())
                        {
                            <MudListItem Class="px-0">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No hay antecedentes registrados.</MudText>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>

                <!-- Vitals Chart -->
                <MudPaper Class="pa-6 rounded-xl" Elevation="2">
                    <div class="d-flex align-center mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Color="Color.Primary" Class="mr-2" />
                        <MudText Typo="Typo.subtitle1">Curva de Presión Arterial</MudText>
                    </div>
                    <MudChart ChartType="ChartType.Line" ChartSeries="@Series" XAxisLabels="@Model.VitalsLabels" Width="100%" Height="250px"></MudChart>
                </MudPaper>
            </MudItem>

            <!-- COLUMNA DERECHA: Pestañas 360 -->
            <MudItem xs="12" md="8">
                <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" Color="Color.Primary">
                    <MudTabPanel Text="Historial y Tratamiento" Icon="@Icons.Material.Filled.MedicalServices">
                        <!-- Active Prescriptions -->
                <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-bold" Color="Color.Primary">
                    <MudIcon Icon="@Icons.Material.Filled.Medication" Size="Size.Small" Class="mr-1 mb-1" />
                    Medicamentos Activos
                </MudText>
                
                <MudGrid Class="mb-6">
                    @foreach(var pres in Model.ActivePrescriptions)
                    {
                        var col = pres.IconColor == "Success" ? Color.Success : Color.Info;
                        <MudItem xs="12" sm="6">
                            <MudPaper Class="pa-4 rounded-xl d-flex align-center" Elevation="1" Style="border-left: 4px solid var(--mud-palette-success);">
                                <MudAvatar Color="@col" Variant="Variant.Filled" Size="Size.Medium" Class="mr-4">
                                    <MudIcon Icon="@Icons.Material.Filled.Vaccines" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle2"><b>@pres.MedicationName</b></MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@pres.Dosage</MudText>
                                    <MudText Typo="Typo.caption" Class="text-muted">@pres.Instructions</MudText>
                                </div>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>

                <!-- Timeline / Historial Clínico -->
                <MudPaper Class="pa-6 rounded-xl" Elevation="1">
                    <div class="d-flex justify-space-between align-center mb-4">
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" />
                            Historial Médico
                        </MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateDirectConsultation" Disabled="IsCreatingConsultation">
                            @if (IsCreatingConsultation)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">Iniciando...</MudText>
                            }
                            else
                            {
                                <text>Nueva Consulta</text>
                            }
                        </MudButton>
                    </div>

                    <MudTimeline TimelinePosition="TimelinePosition.Left" Class="pa-0">
                        @foreach(var item in Model.Consultations)
                        {
                            <MudTimelineItem Color="Color.Primary" Variant="Variant.Outlined">
                                <ItemContent>
                                    <MudCard Elevation="0" Class="pa-4 rounded-lg" Style="background-color: var(--mud-palette-background-grey);">
                                        <div class="d-flex justify-space-between align-center mb-2">
                                            <MudText Typo="Typo.subtitle1"><b>@item.Title</b></MudText>
                                            <MudText Typo="Typo.caption" Class="text-muted">@item.Date.ToString("dd MMM yyyy - hh:mm tt")</MudText>
                                        </div>
                                        <MudText Typo="Typo.body2" Class="mb-3 text-muted" Style="white-space: pre-wrap;">@item.Summary</MudText>
                                        @if (item.IsOwner)
                                        {
                                            <div class="d-flex align-center gap-2">
                                                <MudChip T="string" Color="@(item.StatusId == 1 ? Color.Success : Color.Default)" Size="Size.Small" Variant="Variant.Text">
                                                    @(item.StatusId == 1 ? "En Curso" : "Cerrada")
                                                </MudChip>
                                                @{
                                                    string readonlyParam = item.StatusId != 1 ? "true" : "false"; // 1 is open
                                                }
                                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" Href="@($"/care/consultation/ver/{item.ConsultationId}?readonly={readonlyParam}")">Ver Detalles Completo</MudButton>
                                            </div>
                                        }
                                    </MudCard>
                                </ItemContent>
                            </MudTimelineItem>
                        }
                    </MudTimeline>
                </MudPaper>

                <!-- Digital Consents -->
                <MudPaper Class="pa-6 mt-6 rounded-xl" Elevation="1">
                    <div class="d-flex justify-space-between align-center mb-4">
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Security" Class="mr-2" />
                            Consentimientos Digitales
                        </MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Link" OnClick="OpenConsentModal">
                            Enlazar Formulario
                        </MudButton>
                    </div>

                    @if (Model.Consents.Any())
                    {
                        <MudList T="string">
                            @foreach(var consent in Model.Consents)
                            {
                                <MudListItem>
                                    <div class="d-flex justify-space-between align-center w-100">
                                        <div>
                                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@consent.TypeName</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Enviado: @consent.SignedAt.ToString("dd MMM yyyy - HH:mm")</MudText>
                                        </div>
                                        <MudButton Variant="Variant.Text" Color="Color.Info" StartIcon="@Icons.Material.Filled.OpenInNew" Href="@consent.DigitalFormUrl" Target="_blank">
                                            Abrir Formulario
                                        </MudButton>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Text">No hay consentimientos digitales enviados para este paciente.</MudAlert>
                    }
                </MudPaper>
                    </MudTabPanel>

                    <MudTabPanel Text="Alertas Médicas" Icon="@Icons.Material.Filled.Warning" BadgeData="@Alerts.Count(a => !a.IsAcknowledged)" BadgeColor="Color.Error">
                        <div class="d-flex justify-space-between align-center mb-4">
                            <MudText Typo="Typo.h6">Alertas del Paciente</MudText>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.AddAlert" OnClick="OpenAlertModal">Nueva Alerta</MudButton>
                        </div>
                        
                        @if (!Alerts.Any())
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Text">No hay alertas médicas para este paciente.</MudAlert>
                        }
                        else
                        {
                            <MudList T="string">
                                @foreach (var alert in Alerts)
                                {
                                    var alertColor = alert.SeverityId == 3 ? Color.Error : (alert.SeverityId == 2 ? Color.Warning : Color.Info);
                                    <MudListItem>
                                        <div class="d-flex justify-space-between align-start w-100">
                                            <div>
                                                <MudText Typo="Typo.subtitle1" Color="@alertColor"><b>@alert.Message</b></MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Creada el: @alert.CreatedAt.ToString("dd MMM yyyy") - Tipo: @alert.AlertTypeId</MudText>
                                            </div>
                                            @if (!alert.IsAcknowledged)
                                            {
                                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Check" OnClick="() => AcknowledgeAlert(alert.Id)">
                                                    Marcar Leída
                                                </MudButton>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Color="Color.Success" Size="Size.Small">Leída</MudChip>
                                            }
                                        </div>
                                    </MudListItem>
                                    <MudDivider />
                                }
                            </MudList>
                        }
                    </MudTabPanel>

                    <MudTabPanel Text="Contactos" Icon="@Icons.Material.Filled.ContactPhone">
                        <div class="d-flex justify-space-between align-center mb-4">
                            <MudText Typo="Typo.h6">Red de Apoyo</MudText>
                            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenContactModal">Añadir Contacto</MudButton>
                        </div>

                        @if (!Contacts.Any())
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Text">El paciente no tiene contactos registrados.</MudAlert>
                        }
                        else
                        {
                            <MudGrid>
                                @foreach (var contact in Contacts)
                                {
                                    <MudItem xs="12" sm="6">
                                        <MudCard Elevation="1" Class="pa-3">
                                            <div class="d-flex align-center justify-space-between">
                                                <div class="d-flex align-center">
                                                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="mr-3">
                                                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                                                    </MudAvatar>
                                                    <div>
                                                        <MudText Typo="Typo.subtitle2"><b>@contact.FullName</b></MudText>
                                                        <MudText Typo="Typo.caption" Class="text-muted">@((MedfarLabs.Core.Domain.Enums.Parentesco)contact.RelationshipId)</MudText>
                                                    </div>
                                                </div>
                                                @if (contact.IsPrimary)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Principal</MudChip>
                                                }
                                            </div>
                                            <div class="mt-2">
                                                @if (!string.IsNullOrEmpty(contact.Phone))
                                                {
                                                    <MudText Typo="Typo.body2"><MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="mr-1" /> @contact.Phone</MudText>
                                                }
                                                @if (!string.IsNullOrEmpty(contact.Email))
                                                {
                                                    <MudText Typo="Typo.body2"><MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="mr-1" /> @contact.Email</MudText>
                                                }
                                            </div>
                                        </MudCard>
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                    </MudTabPanel>

                    <MudTabPanel Text="Auditoría" Icon="@Icons.Material.Filled.Security">
                        <MudText Typo="Typo.h6" Class="mb-4">Historial de Accesos al Expediente</MudText>
                        
                        <MudTable Items="@AccessLogs" Dense="true" Hover="true" Elevation="0" Striped="true">
                            <HeaderContent>
                                <MudTh>Fecha</MudTh>
                                <MudTh>Usuario ID</MudTh>
                                <MudTh>Acción</MudTh>
                                <MudTh>Motivo / Razón</MudTh>
                                <MudTh>IP</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Fecha">@context.AccessedAt.ToString("dd MMM yyyy HH:mm:ss")</MudTd>
                                <MudTd DataLabel="Usuario">@context.UserId</MudTd>
                                <MudTd DataLabel="Acción">
                                    <MudChip T="string" Size="Size.Small" Color="@(context.AccessType == "READ" ? Color.Info : Color.Warning)">
                                        @context.AccessType
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="Razón">@context.Reason</MudTd>
                                <MudTd DataLabel="IP">@context.IpAddress</MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager />
                            </PagerContent>
                        </MudTable>
                    </MudTabPanel>
                </MudTabs>
            </MudItem>
        </MudGrid>
    }
</MudContainer>
