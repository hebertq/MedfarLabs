<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudAutocomplete T="string" @bind-Value="Model.MedicationName" SearchFunc="@SearchMedications"
                                 Label="Medicamento (Genérico o Marca)" Variant="Variant.Outlined" 
                                 ResetValueOnEmptyText="false" CoerceText="true" CoerceValue="true"
                                 FullWidth="true" Required="true" />
            </MudItem>
            <MudItem xs="6">
                <MudTextField @bind-Value="Model.Dosage" Label="Dosis" Variant="Variant.Outlined" FullWidth Required="true" />
            </MudItem>
            <MudItem xs="6">
                <MudTextField @bind-Value="Model.Frequency" Label="Frecuencia" Variant="Variant.Outlined" FullWidth Required="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="Model.Duration" Label="Duración" Variant="Variant.Outlined" FullWidth Required="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="Model.Instructions" Label="Instrucciones adicionales" Variant="Variant.Outlined" Lines="3" FullWidth />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!IsFormValid)">Guardar</MudButton>
    </DialogActions>
</MudDialog>

<MedFarLab.Pwa.Shared.Clinical.AllergyWarningModal @ref="AllergyModal" />
