<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="Model.ProductName" Label="Nombre del Insumo / Inyección" Variant="Variant.Outlined" FullWidth Required="true" />
            </MudItem>
            <MudItem xs="12">
                <MudNumericField @bind-Value="Model.Quantity" Label="Cantidad" Variant="Variant.Outlined" FullWidth Required="true" Min="1" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!IsFormValid)">Guardar</MudButton>
    </DialogActions>
</MudDialog>
