<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudAutocomplete T="string" @bind-Value="Model.TestName" SearchFunc="@SearchExams"
                                 Label="Examen Clínico (Búsqueda o Texto libre)" Variant="Variant.Outlined" 
                                 ResetValueOnEmptyText="false" CoerceText="true" CoerceValue="true"
                                 FullWidth="true" Required="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="Model.Notes" Label="Notas / Indicación" Variant="Variant.Outlined" Lines="3" FullWidth />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!IsFormValid)">Guardar</MudButton>
    </DialogActions>
</MudDialog>
