@inherits LayoutComponentBase
@using MudBlazor
@using MedFarLab.Pwa.Shared.Components
@inject MedFarLab.Pwa.Services.MedFarThemeService ThemeService

<MudThemeProvider Theme="@MedFarLab.Pwa.Services.MedFarTheme.Build()"
                  IsDarkMode="@ThemeService.IsDarkMode"/>
<MudSnackbarProvider/>
<MudDialogProvider MaxWidth="MaxWidth.Medium"
                   FullWidth="false"
                   CloseButton="true"
                   BackdropClick="false"/>
<MudPopoverProvider />

<MudLayout Class="@(ThemeService.IsDarkMode ? "theme-dark" : "")">
    <!-- AppBar glassmorphism -->
    <MudAppBar Elevation="0" Class="mf-appbar surface-glass">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Edge="Edge.Start"
                       OnClick="@ToggleDrawer"/>
        <div class="mf-appbar-brand ml-4">
            <img src="/img/logo-medfar.svg" alt="MedFarLab" height="48" onerror="this.src='/images/logo.png';"/>
        </div>
        <MudSpacer/>
        <MedFarProfileMenu />
    </MudAppBar>

    <!-- Sidebar glassmorphism -->
    <MudDrawer @bind-Open="@_drawerOpen"
               Elevation="0"
               Class="mf-sidebar surface-glass"
               ClipMode="DrawerClipMode.Always">
        <MedFarLab.Pwa.Layout.NavMenu/>
    </MudDrawer>

    <!-- Contenido principal -->
    <MudMainContent Class="mf-main-content">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @if (_isMenusLoaded || AppState.UserId == 0)
            {
                @Body
            }
            else
            {
                <div class="d-flex justify-center align-center" style="height: 60vh;">
                    <div class="text-center">
                        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" Class="mb-4"/>
                        <MudText Typo="Typo.h6" Color="Color.Primary">Cargando módulos seguros...</MudText>
                    </div>
                </div>
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    
    protected override void OnInitialized()
    {
        ThemeService.OnChange += StateHasChanged;
        AppState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
        AppState.OnChange -= StateHasChanged;
    }
}
