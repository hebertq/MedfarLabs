@inherits LayoutComponentBase
@using MedFarLab.Pwa.Shared

<ToastContainer />
<MudThemeProvider Theme="MedFarLab.Pwa.Shared.CorporateTheme.ModernTheme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider /> @* <-- AGREGA ESTA LÍNEA *@

<!-- Shell Container App -->
<div class="app-container">
    
    <!-- Desktop Floating Glass Sidebar -->
    <div class="sidebar-wrapper surface-glass fade-in">
        <NavMenu />
    </div>

    <main class="main-content">
        <!-- Topbar Mobile Only -->
        <header class="mobile-topbar d-md-none fade-in">
            <img src="/images/logo.png" alt="MedFarLab" style="height: 55px; transform: translateX(-10px); object-fit: contain;" />
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <ActivatorContent>
                    
                </ActivatorContent>
                <ChildContent>
                    <div class="pa-3">
                        <MudText Typo="Typo.subtitle2">Dr. Admin</MudText>
                        <MudText Typo="Typo.body2" Class="text-muted">admin@medfarlab.com</MudText>
                    </div>
                    <MudDivider />
                    <MudMenuItem Href="/ajustes/medico" Icon="@Icons.Material.Filled.Settings">Ajustes Operativos</MudMenuItem>
                    <MudMenuItem Href="/ajustes" Icon="@Icons.Material.Filled.Business">Mi Clínica</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" Color="Color.Error" OnClick="Logout">Cerrar Sesión</MudMenuItem>
                </ChildContent>
            </MudMenu>
        </header>

        


        <!-- Dynamic Content Display -->
        <div class="content-scrollable">
            <article class="content fade-in" style="animation-delay: 0.1s;">
                @Body
            </article>
        </div>
    </main>

    <!-- Bottom Navigation Pill for Mobile Only -->
    <div class="mobile-navbar-wrapper d-md-none fade-in" style="animation-delay: 0.2s;">
        <div class="mobile-navbar-glass">
            <NavMenu IsMobile="true" />
        </div>
    </div>
</div>


