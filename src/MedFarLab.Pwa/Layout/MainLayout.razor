@inherits LayoutComponentBase
@using MudBlazor
@using MedFarLab.Pwa.Shared.Components
@inject MedFarLab.Pwa.Services.MedFarThemeService ThemeService

<MudThemeProvider Theme="@MedFarLab.Pwa.Services.MedFarTheme.Build()"
                  IsDarkMode="@ThemeService.IsDarkMode"/>
<MudSnackbarProvider/>
<MudDialogProvider MaxWidth="MaxWidth.Medium"
                   FullWidth="false"
                   CloseButton="true"
                   BackdropClick="false"/>
<MudPopoverProvider />

<MudLayout Class="@(ThemeService.IsDarkMode ? "theme-dark" : "")">
    <!-- AppBar glassmorphism -->
    <MudAppBar Elevation="0" Class="mf-appbar surface-glass">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Edge="Edge.Start"
                       OnClick="@ToggleDrawer"/>
        <div class="mf-appbar-brand ml-4">
            <img src="/img/logo-medfar.svg" alt="MedFarLab" height="48" onerror="this.src='/images/logo.png';"/>
        </div>
        <MudSpacer/>
        <MedFarDarkModeToggle/>
        <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                 AnchorOrigin="Origin.BottomRight">
            <MudMenuItem Icon="@Icons.Material.Filled.Person">Mi Perfil</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Cerrar Sesión</MudMenuItem>
        </MudMenu>
    </MudAppBar>

    <!-- Sidebar glassmorphism -->
    <MudDrawer @bind-Open="@_drawerOpen"
               Elevation="0"
               Class="mf-sidebar surface-glass"
               ClipMode="DrawerClipMode.Always">
        <MedFarLab.Pwa.Layout.NavMenu/>
    </MudDrawer>

    <!-- Contenido principal -->
    <MudMainContent Class="mf-main-content">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    
    protected override void OnInitialized()
    {
        ThemeService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
    }
}
