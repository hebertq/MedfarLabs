@inject MedFarLab.Pwa.State.AppState AppState
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@using MediatR
@using MedFarLab.Application.Features.System.Queries.GetMenus
@using MedfarLabs.Core.Application.Features.System.Dtos
@inject IMediator Mediator
@inject NavigationManager NavManager

<MudNavMenu Class="pt-4">
    @if (!AppState.IsMasterAdmin)
    {
        if (MenuService.NavItems == null || !MenuService.NavItems.Any())
        {
            <div class="pa-4 d-flex justify-center flex-column align-center">
                <MedFarLab.Pwa.Shared.Components.MedFarSkeleton Type="MedFarLab.Pwa.Shared.Components.MedFarSkeletonType.List" />
            </div>
        }
        else
        {
            var sidebarMenus = MenuService.NavItems.ToList();
            foreach (var menu in sidebarMenus)
            {
                if (menu.SubMenus != null && menu.SubMenus.Any())
                {
                    <MudNavGroup Title="@menu.Title" Icon="@GetMudIcon(menu.Icon)" Expanded="false">
                        @foreach(var sub in menu.SubMenus)
                        {
                            <MudNavLink Href="@sub.Route" Icon="@GetMudIcon(sub.Icon)" Match="NavLinkMatch.Prefix">@sub.Title</MudNavLink>
                        }
                    </MudNavGroup>
                }
                else
                {
                    <MudNavLink Href="@menu.Route" Icon="@GetMudIcon(menu.Icon)" Match="NavLinkMatch.Prefix">@menu.Title</MudNavLink>
                }
            }
        }

    }
    
    @if (AppState.IsMasterAdmin)
    {
        <MudNavLink Href="/admin/dashboard" Icon="@Icons.Material.Filled.Speed" IconColor="Color.Secondary" Match="NavLinkMatch.Prefix">Central MedfarLabs</MudNavLink>
        <MudNavLink Href="/admin/organizations" Icon="@Icons.Material.Filled.Business" IconColor="Color.Success" Match="NavLinkMatch.Prefix">Organizaciones</MudNavLink>
        <MudNavLink Href="/admin/plans" Icon="@Icons.Material.Filled.Loyalty" IconColor="Color.Info" Match="NavLinkMatch.Prefix">SaaS Planes</MudNavLink>
        <MudNavLink Href="/admin/menus" Icon="@Icons.Material.Filled.MenuOpen" IconColor="Color.Warning" Match="NavLinkMatch.Prefix">Constructor de Menú</MudNavLink>
        <MudDivider Class="my-2" />
        <MudNavLink Href="/admin/laboratory/templates" Icon="@Icons.Material.Filled.Science" IconColor="Color.Info" Match="NavLinkMatch.Prefix">Plantillas Globales Lab</MudNavLink>
    }
</MudNavMenu>
